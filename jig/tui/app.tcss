/* jig/tui/app.tcss */

/* The Screen sits on top of the operator's terminal background. We
   want the active TUI region (panes) to clearly stand apart. Two
   levels of contrast: Screen is $surface (darker, framing), panes
   are $panel (markedly lighter — Textual's "elevated surface" tone). */
Screen {
    background: $surface;
}

TabbedContent {
    height: 1fr;
    background: $panel;
}

TabPane {
    height: 1fr;
    background: $panel;
}

/* Add a visible border around each pane's content so the active region
   is clearly framed. */
NowScreen, TicketsScreen, SpecScreen, EventsScreen {
    border: round $accent;
    margin: 0 1;
    background: $panel;
}
