/* jig/tui/app.tcss */

/* Two clear visual zones:
   1. Chrome (screen + tab strip + pane shell) — true black so the TUI
      frame is unmistakably distinct from the pane content.
   2. Pane content — light blue-grey card sitting on top of the black
      chrome. The user's "terminal area" — kept at the value they
      approved. */
Screen {
    background: #000000;
}

TabbedContent {
    height: 1fr;
    background: #000000;
}

TabPane {
    height: 1fr;
    background: #000000;
}

TabbedContent > Tabs {
    background: #000000;
}

/* Pane content area: clearly elevated card. */
NowScreen, TicketsScreen, SpecScreen, EventsScreen {
    border: round $accent;
    margin: 1 2;
    background: #2d3548;
}

/* Inner widgets match the pane bg so nested borders don't fight. */
RichLog, ListView, Tree, TextArea, Input {
    background: #2d3548;
}
