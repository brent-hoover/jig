/* jig/tui/app.tcss */

/* Three named visual zones, opencode-style:

   FRAME    — true black chrome around the TUI as a whole
              (Screen, TabbedContent, TabPane, Tabs strip)

   DISPLAY  — the read-only area inside a pane: scrollback / list /
              tree. Darker than the composer so it reads as
              "background" the operator's eye scans across.

   COMPOSER — the input area at the bottom of Now (and any future
              forms). Lighter than the display so it reads as the
              "active" zone where the operator's attention lives.

   The pane border + a small frame margin separate the pane from the
   chrome; the contrast between Display and Composer separates the
   read zone from the type zone within a pane. */

Screen {
    background: #000000;
}
TabbedContent {
    height: 1fr;
    background: #000000;
}
TabPane {
    height: 1fr;
    background: #000000;
}
TabbedContent > Tabs {
    background: #000000;
}

/* PANE shell: bordered card the operator interacts with. */
NowScreen, TicketsScreen, SpecScreen, EventsScreen {
    border: round $accent;
    margin: 1 2;
    background: #1a2030;  /* DISPLAY color — pane defaults to read-zone tone */
}

/* DISPLAY widgets: the read zone. */
RichLog, ListView, Tree {
    background: #1a2030;
    scrollbar-size: 0 0;
}

/* When the scrollback gets focus (Shift+Tab), highlight it so the
   operator knows arrow keys now scroll instead of moving cursor. */
RichLog:focus {
    background: #1f2738;
    border-left: tall $accent;
    padding-left: 1;
}

/* COMPOSER widgets: the type zone. Lighter so it stands out. */
TextArea, Input {
    background: #3d4862;
}

NowScreen TextArea {
    border: hidden;
    padding: 0 1;
}
