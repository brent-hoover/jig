/* jig/tui/app.tcss */

/* Three clear visual zones:
   1. Screen / tab strip — the chrome. Stays dark, almost black.
   2. Pane shell — mid grey.
   3. Pane content area — markedly lighter so the active region pops.
   Explicit hex values for absolute contrast control. */
Screen {
    background: #0a0d14;
}

TabbedContent {
    height: 1fr;
    background: #1a1f2c;
}

TabPane {
    height: 1fr;
    background: #1a1f2c;
}

/* Pane content area: substantially brighter so the active region reads
   as an elevated card against the screen chrome. */
NowScreen, TicketsScreen, SpecScreen, EventsScreen {
    border: round $accent;
    margin: 0 1;
    background: #2d3548;
}

/* Inner widgets — scrollback, lists, trees — match the pane bg so
   nested borders don't fight. */
RichLog, ListView, Tree, TextArea, Input {
    background: #2d3548;
}

/* Tab strip should sit on the screen-dark zone, visually separated. */
TabbedContent > Tabs {
    background: #0a0d14;
}
