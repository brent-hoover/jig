/* jig/tui/app.tcss */

/* Two clear visual zones:
   1. Screen — the chrome around the panes. Stays dark, almost black.
   2. Panes — the active content area. Visibly brighter so the operator
      can read where the TUI begins/ends.
   Explicit hex values for absolute contrast control (Textual's $panel
   varies by theme; on some dark themes the differential is too small). */
Screen {
    background: #0a0d14;
}

TabbedContent {
    height: 1fr;
    background: #161b27;
}

TabPane {
    height: 1fr;
    background: #161b27;
}

/* Pane content area: brighter still, with a clear accent border. */
NowScreen, TicketsScreen, SpecScreen, EventsScreen {
    border: round $accent;
    margin: 0 1;
    background: #1c2230;
}

/* Inner widgets — scrollback, lists, trees — match the pane bg so
   nested borders don't fight. */
RichLog, ListView, Tree, TextArea, Input {
    background: #1c2230;
}

/* Tab strip should sit on the screen-dark zone, visually separated. */
TabbedContent > Tabs {
    background: #0a0d14;
}
